<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{{ title }}</title>
  {% if metaDescription %}<meta name="description" content="{{ metaDescription }}">{% endif %}

  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ ogTitle or title }}">
  <meta property="og:description" content="{{ ogDescription or metaDescription or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ ogImage or site.defaultOgImage }}">
  <meta name="twitter:card" content="summary_large_image">

  {% if page.url == "/" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ site.name }}",
    "legalName": "{{ site.legalName }}",
    "url": "{{ site.url }}",
    "description": "{{ site.description }}",
    "email": "{{ site.email }}",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Kuala Lumpur",
      "addressCountry": "MY"
    },
    "sameAs": ["{{ site.instagram }}"]
  }
  </script>
  {% endif %}

  <link rel="stylesheet" href="https://use.typekit.net/zbv8ksi.css">
  <link rel="stylesheet" href="/css/eb.css">
  <link rel="stylesheet" href="/css/project.css">
  <link rel="stylesheet" href="/css/archive.css">
  <link rel="stylesheet" href="/css/home.css">
</head>
<body>

  <header class="site-nav">
    <a href="/" class="h4">Elena Blair</a>
    <nav>
      <a href="/the-archive/" class="nav-label">The Archive</a>
      <a href="https://forms.elenablair.com/enquiry" class="nav-label">The Commission</a>
    </nav>
  </header>

  {{ content | safe }}

  <footer class="site-footer">
    <div class="site-footer__left">
      <p class="caption">&copy; Elena Blair &middot; Elite Corridor Sdn Bhd</p>
      <p class="caption site-footer__reg">Company No. 431111-V</p>
    </div>
    <div class="site-footer__right">
      <p class="caption"><a href="mailto:sayhello@elenablair.com" class="link-hover">sayhello@elenablair.com</a></p>
      <p class="caption"><a href="https://www.instagram.com/elenablair.official/" class="link-hover" target="_blank" rel="noopener">Instagram</a></p>
    </div>
  </footer>

</body>
</html>
