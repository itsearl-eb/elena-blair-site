<main class="commission measure">

  <header class="commission__intro">
    <h1 class="h2-lg">The Commission</h1>
    <p class="commission__lead">We take on a limited number of commissions each season. Tell us about your project and we'll come back to you if it's a fit. The more specific you are, the better the conversation we can have.</p>
    <p class="commission__lead commission__lead--quiet">No decks required. Just tell us what you're trying to make.</p>
  </header>

  <form id="enquiry-form" class="enquiry" novalidate>

    <p class="section-label">01 — Who you are</p>

    <div class="two-col">
      <div class="field">
        <label class="field-label" for="first_name">First name</label>
        <input type="text" id="first_name" name="first_name" required>
      </div>
      <div class="field">
        <label class="field-label" for="last_name">Last name</label>
        <input type="text" id="last_name" name="last_name" required>
      </div>
    </div>

    <div class="two-col">
      <div class="field">
        <label class="field-label" for="company">Company / brand <span class="optional">(optional)</span></label>
        <input type="text" id="company" name="company">
      </div>
      <div class="field">
        <label class="field-label" for="role">Your role <span class="optional">(optional)</span></label>
        <input type="text" id="role" name="role" placeholder="e.g. Creative Director, Stylist">
      </div>
    </div>

    <div class="two-col">
      <div class="field">
        <label class="field-label" for="email">Email</label>
        <input type="email" id="email" name="email" required>
      </div>
      <div class="field">
        <label class="field-label" for="phone">WhatsApp / Phone <span class="optional">(optional)</span></label>
        <input type="tel" id="phone" name="phone">
      </div>
    </div>

    <div class="two-col">
      <div class="field">
        <label class="field-label" for="instagram">Instagram <span class="optional">(optional)</span></label>
        <input type="text" id="instagram" name="instagram" placeholder="@">
      </div>
      <div class="field">
        <label class="field-label" for="website">Website <span class="optional">(optional)</span></label>
        <input type="url" id="website" name="website" placeholder="https://">
      </div>
    </div>

    <div class="field">
      <label class="field-label" for="how_found">How did you find us?</label>
      <select id="how_found" name="how_found" required>
        <option value="" disabled selected></option>
        <option>Instagram</option>
        <option>Word of mouth</option>
        <option>Editorial / publication</option>
        <option>Google</option>
        <option>Worked together before</option>
        <option>Other</option>
      </select>
    </div>

    <hr class="divider">
    <p class="section-label">02 — The project</p>

    <div class="field">
      <label class="field-label" for="project_type">Type of project</label>
      <select id="project_type" name="project_type" required>
        <option value="" disabled selected></option>
        <option>Editorial</option>
        <option>Campaign</option>
        <option>Collection</option>
        <option>Other</option>
      </select>
    </div>

    <div class="field" id="field-deliverables">
      <label class="field-label">Deliverables</label>
      <div class="check-group" id="deliverables-group">
        <label class="check-item"><input type="checkbox" value="Stills"> Stills</label>
        <label class="check-item"><input type="checkbox" value="Stills + video"> Stills + video</label>
        <label class="check-item"><input type="checkbox" value="Video only"> Video only</label>
        <label class="check-item"><input type="checkbox" value="Not sure yet"> Not sure yet</label>
      </div>
    </div>

    <div class="field" id="field-usage">
      <label class="field-label">Intended usage</label>
      <span class="helper">Select all that apply.</span>
      <div class="check-group" id="usage-group">
        <label class="check-item"><input type="checkbox" value="Social media"> Social media</label>
        <label class="check-item"><input type="checkbox" value="Digital — website + online collateral"> Digital — website + online collateral</label>
        <label class="check-item"><input type="checkbox" value="Print collateral — lookbook, in-store, leaflet"> Print collateral — lookbook, in-store, leaflet</label>
        <label class="check-item"><input type="checkbox" value="Advertising — digital + print ads"> Advertising — digital + print ads</label>
        <label class="check-item"><input type="checkbox" value="Editorial / publication"> Editorial / publication</label>
        <label class="check-item"><input type="checkbox" value="OOH / Billboard"> OOH / Billboard</label>
        <label class="check-item"><input type="checkbox" value="TV / Broadcast"> TV / Broadcast</label>
      </div>
      <span class="field-error-msg">Please select at least one usage type.</span>
    </div>

    <div class="field" id="field-territory">
      <label class="field-label">Territory</label>
      <div class="check-group">
        <label class="check-item"><input type="radio" name="territory" value="Malaysia only"> Malaysia only</label>
        <label class="check-item"><input type="radio" name="territory" value="Southeast Asia (SEA)"> Southeast Asia (SEA)</label>
        <label class="check-item"><input type="radio" name="territory" value="Worldwide"> Worldwide</label>
      </div>
      <span class="field-error-msg">Please select a territory.</span>
    </div>

    <div class="field">
      <label class="field-label" for="timeline">Timeline — shoot date or window in mind</label>
      <input type="text" id="timeline" name="timeline" placeholder="e.g. Mid-March, Q2, flexible">
    </div>

    <div class="field">
      <label class="field-label" for="budget">Budget range</label>
      <select id="budget" name="budget" required>
        <option value="" disabled selected></option>
        <option>RM 5,000 – RM 10,000</option>
        <option>RM 10,000 – RM 20,000</option>
        <option>RM 20,000 – RM 40,000</option>
        <option>Above RM 40,000</option>
        <option>To be discussed</option>
      </select>
    </div>

    <hr class="divider">
    <p class="section-label">03 — The brief</p>

    <div class="field">
      <label class="field-label" for="brief">Tell us about the project</label>
      <textarea id="brief" name="brief" required placeholder="What are you making, who is it for, and what do you want it to feel like?"></textarea>
      <span class="helper">No formal brief needed — a few sentences is enough to start.</span>
    </div>

    <div class="field">
      <label class="field-label" for="references">References — images, campaigns, editorials, anything that points in the right direction</label>
      <textarea id="references" name="references" placeholder="Links, names, descriptions — anything works"></textarea>
    </div>

    <div class="field">
      <label class="field-label" for="anything_else">Anything else we should know</label>
      <textarea id="anything_else" name="anything_else" placeholder="Specific requirements, constraints, or context"></textarea>
    </div>

    <div class="submit-wrap">
      <button type="submit" id="submit-btn">Send enquiry</button>
      <p class="footer-note">We review all enquiries personally and respond within 7 days. If it's a fit, we'll reach out to arrange a call.</p>
      <p class="error-msg" id="error-msg">Something went wrong. Please try again or contact us at sayhello@elenablair.com.</p>
    </div>

  </form>

</main>

<!-- Spam protection (dashboard §128, item 9). Site key in its own file; the
     SECRET half is a Netlify env var (TURNSTILE_SECRET_KEY) and the function
     does the verifying. No site key means no widget and no Cloudflare
     script, and the honeypot still works. -->
<script src="/js/turnstile-key.js"></script>
<script src="/js/spam-guard.js"></script>
<script src="/js/form-validation.js"></script>
<script>
  (function () {
    var form = document.getElementById('enquiry-form');
    // Injects the off-screen honeypot, and the Turnstile widget if a site key
    // is configured. Neither is a defence here — the function decides.
    if (window.EBSpamGuard) EBSpamGuard.install(form);
    var btn = document.getElementById('submit-btn');
    var errorMsg = document.getElementById('error-msg');

    function getChecked(groupId) {
      var group = document.getElementById(groupId);
      return Array.prototype.slice
        .call(group.querySelectorAll('input[type="checkbox"]:checked'))
        .map(function (cb) { return cb.value; })
        .join(', ');
    }

    if (window.EBValidate) EBValidate.watch(form);

    form.addEventListener('submit', function (e) {
      e.preventDefault();

      // **One message per field, in the field** (§131 item 10), replacing a
      // sweep that coloured everything `required` and then said "Please
      // complete all required fields" at the bottom. On a form this long
      // that is a scavenger hunt: you scroll looking for red, and the one
      // you missed is below the fold.
      var el = function (id) { return document.getElementById(id); };
      var checks = [
        { el: el('first_name'), message: 'Enter your first name' },
        { el: el('last_name'), message: 'Enter your last name' },
        { el: el('email'), message: 'Enter your email address' },
        { el: el('how_found'), message: 'Tell us how you found us' },
        { el: el('project_type'), message: 'Choose the type of project' },
        {
          el: el('field-deliverables'),
          message: 'Choose at least one deliverable',
          invalid: function () { return !getChecked('deliverables-group'); },
        },
        {
          el: el('field-usage'),
          message: 'Choose at least one usage type',
          invalid: function () { return !getChecked('usage-group'); },
        },
        {
          el: el('field-territory'),
          radioName: 'territory',
          message: 'Choose a territory',
        },
        { el: el('budget'), message: 'Choose a budget range' },
        { el: el('brief'), message: 'Tell us what you are making' },
      ].filter(function (c) { return c.el; });

      if (!EBValidate.validate(form, checks)) return;

      errorMsg.style.display = 'none';
      btn.disabled = true;
      btn.textContent = 'Sending...';

      // Read AFTER validation passes, and declared here rather than left as
      // free references in the payload — the §131 item 10 refactor moved the
      // group checks into `checks` and deleted these three, so the payload
      // threw a ReferenceError on a form that had just validated cleanly.
      // The button said "Sending..." and nothing was ever sent.
      var deliverables = getChecked('deliverables-group');
      var usage = getChecked('usage-group');
      var territoryEl = form.querySelector('input[name="territory"]:checked');

      var payload = {
        first_name: document.getElementById('first_name').value,
        last_name: document.getElementById('last_name').value,
        company: document.getElementById('company').value,
        role: document.getElementById('role').value,
        email: document.getElementById('email').value,
        phone: document.getElementById('phone').value,
        instagram: document.getElementById('instagram').value,
        website: document.getElementById('website').value,
        how_found: document.getElementById('how_found').value,
        project_type: document.getElementById('project_type').value,
        deliverables: deliverables,
        usage: usage,
        territory: territoryEl ? territoryEl.value : '',
        timeline: document.getElementById('timeline').value,
        budget: document.getElementById('budget').value,
        brief: document.getElementById('brief').value,
        references: document.getElementById('references').value,
        anything_else: document.getElementById('anything_else').value
      };

      fetch('/.netlify/functions/submit-enquiry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        // The honeypot's value and the Turnstile token ride along. The
        // honeypot is sent even when FILLED IN — the function needs to see
        // that, so this must not helpfully omit it.
        body: JSON.stringify(
          window.EBSpamGuard ? Object.assign({}, payload, EBSpamGuard.fields(form)) : payload
        )
      })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          if (data && data.success) {
            window.location.href = '/the-commission/thank-you/';
          } else {
            throw new Error('API error');
          }
        })
        .catch(function () {
          btn.disabled = false;
          btn.textContent = 'Send enquiry';
          errorMsg.style.display = 'block';
          errorMsg.textContent = 'Something went wrong. Please try again or contact us at sayhello@elenablair.com.';
        });
    });
  })();
</script>
